private CHPreparationGraph(int nodes, int edges, boolean edgeBased, TurnCostFunction turnCostFunction) {
    this.turnCostFunction = turnCostFunction;
    this.nodes = nodes;
    this.edges = edges;
    this.edgeBased = edgeBased;
    prepareEdgesOut = new PrepareEdge[nodes];
