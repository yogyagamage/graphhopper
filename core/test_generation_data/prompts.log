path: com.graphhopper.routing.util.RoadDensityCalculator.calcRoadDensity(com.graphhopper.util.EdgeIteratorState, double, java.util.function.ToDoubleFunction) -> com.carrotsearch.hppc.IntArrayDeque.addLast(int)
