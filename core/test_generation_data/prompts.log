    checkProfileCompatibility();
    weighting = createWeighting();
}

protected void checkProfileCompatibility() {
    if ((!profile.isTurnCosts()) && (!request.getCurbsides().isEmpty())) {
        throw new IllegalArgumentException(((("To make use of the " + CURBSIDE) + " parameter you need to use a profile that supports turn costs") + "
The following profiles do support turn costs: ") + getTurnCostProfiles());
    }
    if ((request.getCustomModel() != null) && (!CustomWeighting.NAME.equals(profile.getWeighting()))) {
        throw // PATH: Test should invoke the next GHRequest.getProfile(...) [step in execution path]
        new IllegalArgumentException((("The requested profile '" + request.getProfile()) + "' cannot be used with `custom_model`, because it has weighting=") + profile.getWeighting());
    }
    final int uTurnCostsInt = request.getHints().getInt(Parameters.Routing.U_TURN_COSTS, INFINITE_U_TURN_COSTS);
    if ((uTurnCostsInt != INFINITE_U_TURN_COSTS) && (!profile.isTurnCosts())) {
        throw new IllegalArgumentException(("Finite u-turn costs can only be used for edge-based routing, you need to use a profile that" + " supports turn costs. Currently the following profiles that support turn costs are available: ") + getTurnCostProfiles());
    }
}
