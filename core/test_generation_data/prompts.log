    super(request, profilesByName, routerConfig, lookup);
    this.routerConfig = routerConfig;
    this.weightingFactory = weightingFactory;
    this.baseGraph = graph;
    this.locationIndex = locationIndex;
}

LMSolver(GHRequest request, Map<String, Profile> profilesByName, RouterConfig routerConfig, EncodedValueLookup lookup, WeightingFactory weightingFactory, BaseGraph graph, LocationIndex locationIndex, Map<String, LandmarkStorage> landmarks) {
    super(request, profilesByName, routerConfig, lookup, weightingFactory, graph, locationIndex);
    this.landmarks = landmarks;
}
