            if (ok1) {
                e = E1;
                ccw = cut1 > 0;
            } else if (ok2) {
                e = E2;
                ccw = cut2 > 0;
            } else {
                // This must be the end of the polyline...
                break;
            }
        } 
        // Close the polyline
        polyPoints.add(polyPoints.get(0));
        if (polyPoints.size() >= 4) {
            LinearRing ring = geometryFactory.createLinearRing(polyPoints.toArray(new Coordinate[polyPoints.size()]));
            rings.add(ring);
        }
    }
    List<Polygon> isolinePolygons = punchHoles(rings);
    // PATH: Test should invoke the next GeometryFactory.createMultiPolygon(...) [step in execution path]
    return geometryFactory.createMultiPolygon(isolinePolygons.toArray(new Polygon[isolinePolygons.size()]));
}
