        q = high;
        adj = -1;
    } else if ((a == (-2)) && (high == (-2))) {
        dfsState = State.BUILD_COMPONENT;
        p = low;
        q = -1;
        adj = -1;
    } else if (high == (-1)) {
        dfsState = State.FIND_COMPONENT;
        p = low;
        q = -1;
        adj = a;
    } else {
        assert ((low >= 0) && (high >= 0)) && (a >= 0);
        dfsState = State.HANDLE_NEIGHBOR;
        p = low;
        q = high;
        adj = a;
    }
}

private void pushBuildComponent(int p) {
    assert p >= 0;
    dfsStackPQ.addLast(bitUtil.toLong(p, -2));
