        // Setup graph bounds to avoid PointOutOfBoundsException
        Mockito.when(graph.getBounds()).thenReturn(new com.graphhopper.util.shapes.BBox(-180, 180, -90, 90));

        // Create Router instance
        Router router = new Router(
                graph,
                encodingManager,
                locationIndex,
                profilesByName,
                pathDetailsBuilderFactory,
                translationMap,
                routerConfig,
                weightingFactory,
                chGraphs,
                landmarks
        );

        // Create GHRequest with at least one point to avoid checkAtLeastOnePoint exception
        GHRequest request = new GHRequest();
        request.setPoints(Arrays.asList(new GHPoint(0, 0), new GHPoint(0.1, 0.1)));

        // Call the entry point method
        router.route(request);
    }
}

