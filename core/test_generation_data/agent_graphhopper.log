    for (LinearRing ring : rings) {
        if (CGAlgorithms.signedArea(ring.getCoordinateSequence()) > 0.0) {
            holes.add(ring);
        } else {
            shells.add(new PreparedPolygon(geometryFactory.createPolygon(ring)));
