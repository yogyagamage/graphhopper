public MultiPolygon computeIsoline(double z0, Collection<ReadableQuadEdge> seedEdges) {
    ToIntBiFunction<Vertex, Vertex> cut = (orig, dest) -> {
        double za = orig.getZ();
        double zb = dest.getZ();
        if ((za <= z0) && (zb > z0)) {
            return 1;
        }
        if ((za > z0) && (zb <= z0)) {
            return -1;
        }
        return 0;
    };
    // PATH: Test should invoke the next ContourBuilder.computeIsoline(...) [step in execution path]
    return computeIsoline(cut, seedEdges);
}

