public class PolygontoString_GeometrygetNumGeometriesFikaTest {

    @Test
    public void testToStringTriggersGetNumGeometries() {
        // Create coordinates for a simple triangle polygon
        Coordinate[] coordinates = new Coordinate[] {
            new Coordinate(0, 0),
            new Coordinate(1, 0),
            new Coordinate(0, 1),
            new Coordinate(0, 0) // Close the polygon
        };
        
        // Create the JTS polygon using the same factory as in Polygon class
