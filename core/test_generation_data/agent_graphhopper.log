package com.graphhopper.routing;

import com.carrotsearch.hppc.IntArrayList;
import com.graphhopper.routing.querygraph.QueryGraph;
import com.graphhopper.routing.util.DirectedEdgeFilter;
import com.graphhopper.storage.index.Snap;
import com.graphhopper.util.shapes.GHPoint;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.util.ArrayList;
import java.util.List;

import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.anyDouble;
import static org.mockito.ArgumentMatchers.anyInt;
import static org.mockito.Mockito.when;

public class ViaRoutingbuildEdgeRestrictions_IntArrayListaddAllFikaTest {

    @Test
    public void testCalcPathsToBuildEdgeRestrictionsToIntArrayListAddAll() {
        // Mock QueryGraph
        QueryGraph queryGraph = Mockito.mock(QueryGraph.class);
        when(queryGraph.isVirtualEdge(anyInt())).thenReturn(false);
        
        // Mock Snap objects
        Snap fromSnap = Mockito.mock(Snap.class);
        Snap toSnap = Mockito.mock(Snap.class);
        when(fromSnap.getClosestNode()).thenReturn(1);
        when(toSnap.getClosestNode()).thenReturn(2);
        when(fromSnap.getQueryPoint()).thenReturn(new GHPoint(0, 0));
        when(toSnap.getQueryPoint()).thenReturn(new GHPoint(0.01, 0.01));
        
        // Mock PathCalculator
        PathCalculator pathCalculator = Mockito.mock(PathCalculator.class);
        when(pathCalculator.calcPaths(anyInt(), anyInt(), any(EdgeRestrictions.class)))
                .thenReturn(new ArrayList<>());
        when(pathCalculator.getDebugString()).thenReturn("");
        when(pathCalculator.getVisitedNodes()).thenReturn(0);
        
        // Mock HeadingResolver to return non-empty IntArrayList
        HeadingResolver headingResolver = Mockito.mock(HeadingResolver.class);
        IntArrayList mockIntArrayList = new IntArrayList();
        mockIntArrayList.add(123);
        when(headingResolver.getEdgesWithDifferentHeading(anyInt(), anyDouble()))
                .thenReturn(mockIntArrayList);
        
        // Use reflection to inject mocked HeadingResolver into ViaRouting
        // Since buildEdgeRestrictions is private static, we rely on the path through calcPaths
        // which will create a real HeadingResolver. To ensure IntArrayList.addAll is called,
        // we need to trigger the heading branch in buildEdgeRestrictions.
        
        // Prepare inputs for calcPaths
        List<GHPoint> points = new ArrayList<>();
        points.add(new GHPoint(0, 0));
        points.add(new GHPoint(0.01, 0.01));
        
        List<Snap> snaps = new ArrayList<>();
        snaps.add(fromSnap);
        snaps.add(toSnap);
        
        DirectedEdgeFilter directedEdgeFilter = (edge, reverse) -> true;
        
        List<String> curbsides = new ArrayList<>();
        
        List<Double> headings = new ArrayList<>();
        headings.add(90.0); // This will trigger the fromHeading branch
        headings.add(Double.NaN); // toHeading will be NaN
        
        // Execute the entry point
        ViaRouting.calcPaths(
                points,
                queryGraph,
                snaps,
                directedEdgeFilter,
                pathCalculator,
                curbsides,
                false,
                headings,
                false
        );
        
        // No assertions - test passes if no exception is thrown
        // and the execution reaches IntArrayList.addAll via:
        // calcPaths -> buildEdgeRestrictions -> IntArrayList.addAll
    }
}

