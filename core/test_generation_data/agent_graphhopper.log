        Mockito.when(edge2.dNext()).thenReturn(edge1);
        Mockito.when(edge2.dPrev()).thenReturn(edge3);
        Mockito.when(edge3.dNext()).thenReturn(edge2);
        Mockito.when(edge3.dPrev()).thenReturn(edge1);
        
