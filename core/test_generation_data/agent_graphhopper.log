public void update(double lat, double lon) {
    if (lat > maxLat) {
        maxLat = lat;
    }
    if (lat < minLat) {
        minLat = lat;
    }
    if (lon > maxLon) {
        maxLon = lon;
    }
    if (lon < minLon) {
        minLon = lon;
    }
}

public void update(double lat, double lon, double elev) {
    if (elevation) {
        if (elev > maxEle) {
            maxEle = elev;
        }
        if (elev < minEle) {
            minEle = elev;
        }
    } else {
        throw new IllegalStateException("No BBox with elevation to update");
    }
    update(lat, lon);
}
