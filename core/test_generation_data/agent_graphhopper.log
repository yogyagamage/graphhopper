                callback.onTile(coord);
            }
        };

        // Create a simple SpatialKeyAlgo that returns a valid key
        SpatialKeyAlgo keyAlgo = new SpatialKeyAlgo(1) {
            @Override
            public long encode(double lat, double lon) {
                return 123L;
            }
            
            @Override
            public long encode(int x, int y) {
                return 123L;
            }
            
            @Override
