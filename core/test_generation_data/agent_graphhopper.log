class SimpleReadableTriangulation implements ReadableTriangulation {
    @Override
    public int getNumVertices() { return 0; }
    @Override
    public Vertex getVertex(int index) { return null; }
    @Override
    public int getNumEdges() { return 0; }
    @Override
    public ReadableQuadEdge getEdge(int index) { return null; }
    @Override
    public ReadableQuadEdge getVertexQuadEdge(int vertexIndex) { return null; }
    @Override
