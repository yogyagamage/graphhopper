    coordinates[lats.length] = coordinates[0];
    this.prepPolygon = new PreparedPolygon(factory.createPolygon(new PackedCoordinateSequence.Double(coordinates, 2)));
    this.rectangle = prepPolygon.getGeometry().isRectangle();
