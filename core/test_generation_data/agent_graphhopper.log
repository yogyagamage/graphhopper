        DataAccess heights = getDirectory().create(name + ".gh");
        demProvider.setHeights(heights);
        boolean loadExisting = false;
        try {
            loadExisting = heights.loadExisting();
        } catch (Exception ex) {
            logger.warn((("cannot load " + name) + ", error: ") + ex.getMessage());
        }
        if (!loadExisting) {
