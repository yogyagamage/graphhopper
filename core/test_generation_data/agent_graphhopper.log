    setMaxLevelOnAllNodes();
    if (nodeOrderingProvider != null) {
        contractNodesUsingFixedNodeOrdering();
    } else // PATH: Test should invoke the next PrepareContractionHierarchies.contractNodesUsingHeuristicNodeOrdering(...) [step in execution path]
    {
        contractNodesUsingHeuristicNodeOrdering();
