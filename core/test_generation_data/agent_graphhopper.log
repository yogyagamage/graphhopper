package com.graphhopper.reader.osm.pbf;

import com.graphhopper.reader.osm.SkipOptions;
import org.junit.jupiter.api.Test;
import org.openstreetmap.osmosis.osmbinary.Fileformat;

import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.util.zip.Deflater;

import static org.mockito.Mockito.mock;

public class PbfBlobDecoderreadBlobContent_BlobhasZlibDataFikaTest {

    @Test
    public void testRunToHasZlibData() throws IOException {
        // Create a blob with zlib data to ensure hasZlibData() is called
        byte[] zlibData = createZlibData();
        
        Fileformat.Blob.Builder blobBuilder = Fileformat.Blob.newBuilder();
        Fileformat.Blob.Data.Builder dataBuilder = Fileformat.Blob.Data.newBuilder();
        dataBuilder.setZlibData(com.google.protobuf.ByteString.copyFrom(zlibData));
        dataBuilder.setRawSize(4); // Original size of "test"
        blobBuilder.setZlibData(dataBuilder.build());
        
        byte[] rawBlob = blobBuilder.build().toByteArray();
        
        // Create mock listener
        PbfBlobDecoderListener listener = mock(PbfBlobDecoderListener.class);
        
        // Create SkipOptions
        SkipOptions skipOptions = new SkipOptions();
        
        // Instantiate PbfBlobDecoder with OSMHeader blob type to go through readBlobContent()
        PbfBlobDecoder decoder = new PbfBlobDecoder(
            "OSMHeader",
            rawBlob,
            listener,
            skipOptions
        );
        
        // Call the entry point method
        decoder.run();
    }
    
    private byte[] createZlibData() throws IOException {
        byte[] testData = "test".getBytes();
        Deflater deflater = new Deflater();
        deflater.setInput(testData);
        deflater.finish();
        
        ByteArrayOutputStream outputStream = new ByteArrayOutputStream();
        byte[] buffer = new byte[1024];
        while (!deflater.finished()) {
            int count = deflater.deflate(buffer);
            outputStream.write(buffer, 0, count);
        }
        deflater.end();
        
        return outputStream.toByteArray();
    }
}

