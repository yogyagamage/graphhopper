    @Test
    public void testMainToWrapInputStream() throws Exception {
        // Create a temporary directory for cache
        File tempDir = new File(System.getProperty("java.io.tmpdir"), "cgiar-test-" + System.currentTimeMillis());
        tempDir.mkdirs();
        
        // Create instance using constructor with cache directory parameter
        CGIARProvider provider = new CGIARProvider(tempDir.getAbsolutePath());
        
        // Use reflection to set up necessary state to avoid external downloads
        // Set cacheDir to our temp directory
        Field cacheDirField = provider.getClass().getSuperclass().getDeclaredField("cacheDir");
        cacheDirField.setAccessible(true);
        cacheDirField.set(provider, tempDir);
        
