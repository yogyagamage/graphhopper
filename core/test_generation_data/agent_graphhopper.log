    for (T area : areas) {
        for (Polygon border : area.getBorders()) {
            IndexedCustomArea<T> indexedCustomArea = new IndexedCustomArea<>(area, pgf.create(border));
            index.insert(border.getEnvelopeInternal(), indexedCustomArea);
        }
