import java.util.Map;

public class Router_SolvergetProfile_GHRequestgetProfileFikaTest {

    @Test
    public void testRouteCallsGetProfile() {
        // Create minimal required objects
        BaseGraph graph = new BaseGraph.Builder(1).create();
        EncodingManager encodingManager = EncodingManager.create("car");
        LocationIndex locationIndex = new LocationIndex.NodeIndex(graph, graph.getBounds());
        Map<String, Profile> profilesByName = new HashMap<>();
        profilesByName.put("car", new Profile("car"));
        PathDetailsBuilderFactory pathDetailsBuilderFactory = new PathDetailsBuilderFactory();
        TranslationMap translationMap = new TranslationMap().doImport();
        RouterConfig routerConfig = new RouterConfig();
        WeightingFactory weightingFactory = new WeightingFactory(encodingManager);
        Map<String, RoutingCHGraph> chGraphs = new HashMap<>();
        Map<String, Object> landmarks = new HashMap<>();

        // Create Router instance
        Router router = new Router(
                graph,
                encodingManager,
                locationIndex,
                profilesByName,
                pathDetailsBuilderFactory,
                translationMap,
                routerConfig,
                weightingFactory,
                chGraphs,
                landmarks
        );

        // Create GHRequest with required data
        GHRequest request = new GHRequest();
        request.setProfile("car");
        request.addPoint(new GHPoint(49.0, 11.0));
        request.addPoint(new GHPoint(49.1, 11.1));

        // Call the entry point method
        GHResponse response = router.route(request);
    }
}

