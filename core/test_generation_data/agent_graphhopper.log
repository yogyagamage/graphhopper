package com.graphhopper.routing.ev;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.junit.jupiter.api.Test;
import com.graphhopper.routing.ev.EncodedValue;

import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

public class EncodedValueSerializerserializeEncodedValue_JsonProcessingExceptiongetMessageFikaTest {

    @Test
    public void testSerializeEncodedValue() throws Exception {
        // Create a mock EncodedValue that will cause JsonProcessingException
        EncodedValue mockEncodedValue = mock(EncodedValue.class);
        
        // Create a custom ObjectMapper that throws JsonProcessingException
        ObjectMapper throwingMapper = new ObjectMapper() {
            @Override
            public <T> T convertValue(Object fromValue, Class<T> toValueType) {
                throw new RuntimeException(new JsonProcessingException("Test exception") {});
            }
        };
        
        // Use reflection to set the MAPPER field to our throwing mapper
        java.lang.reflect.Field mapperField = EncodedValueSerializer.class.getDeclaredField("MAPPER");
        mapperField.setAccessible(true);
        ObjectMapper originalMapper = (ObjectMapper) mapperField.get(null);
        
        try {
            mapperField.set(null, throwingMapper);
            
            // This call should trigger JsonProcessingException.getMessage()
            EncodedValueSerializer.serializeEncodedValue(mockEncodedValue);
            
        } finally {
            // Restore original mapper
            mapperField.set(null, originalMapper);
        }
    }
}

