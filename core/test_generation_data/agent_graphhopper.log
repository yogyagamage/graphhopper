public Result triangulate(Snap snap, QueryGraph queryGraph, ShortestPathTree shortestPathTree, ToDoubleFunction<ShortestPathTree.IsoLabel> fz, double tolerance) // PATH: Test should invoke the next new ConformingDelaunayTriangulator(...) [step in execution path]
