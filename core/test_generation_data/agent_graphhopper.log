        Mockito.when(triangulation.isFrameVertex(v2)).thenReturn(false);
        Mockito.when(triangulation.isFrameVertex(v3)).thenReturn(false);
        
        // Create ContourBuilder instance
        ContourBuilder contourBuilder = new ContourBuilder(triangulation);
        
        // Create seed edges collection
