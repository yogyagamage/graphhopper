    @Override
    public double getY(int vertexIndex) { return 0; }
    @Override
    public double getZ(int vertexIndex) { return 0; }
}

class SimpleReadableQuadEdge implements ReadableQuadEdge {
    private Vertex orig;
    private Vertex dest;
    private SimpleReadableQuadEdge next;
    
    public SimpleReadableQuadEdge(Vertex orig, Vertex dest) {
        this.orig = orig;
        this.dest = dest;
    }
    
    public void setNext(SimpleReadableQuadEdge next) {
        this.next = next;
    }
    
    @Override
    public Vertex orig() { return orig; }
    @Override
    public Vertex dest() { return dest; }
    @Override
    public ReadableQuadEdge oNext() { return next; }
    @Override
    public ReadableQuadEdge oPrev() { return null; }
    @Override
    public ReadableQuadEdge dNext() { return null; }
    @Override
    public ReadableQuadEdge dPrev() { return null; }
    @Override
    public ReadableQuadEdge getPrimary() { return this; }
    @Override
    public Vertex midPoint(Vertex other) { 
        return new Vertex((orig.getX() + dest.getX()) / 2, (orig.getY() + dest.getY()) / 2);
    }
}

