        PreparedPolygon preparedPolygon = new PreparedPolygon(jtsPolygon);
        
        // Create Polygon instance using the constructor that takes PreparedPolygon
        Polygon polygon = new Polygon(preparedPolygon);
        
        // Call toString() which should trigger Geometry.getNumGeometries()
        polygon.toString();
    }
}

