            Raster raster = readFile(zipFile, name + ".tif");
            fillDataAccessWithElevationData(raster, heights, WIDTH);
        }// loadExisting

    }
    if (demProvider.isSeaLevel()) {
        return 0;
    }
    return demProvider.getHeight(lat, lon);
}

