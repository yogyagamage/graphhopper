        double searchDistance = maxWindowSize / 2.0;
        double searchDistanceBack = 0.0;
        for (int j = i - 1; j >= 0; j--) {
            searchDistanceBack += distances[j];
            if (searchDistanceBack > searchDistance) {
                break;
            }
