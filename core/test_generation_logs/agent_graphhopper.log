package com.graphhopper.util.shapes;

import org.junit.jupiter.api.Test;
import org.locationtech.jts.geom.Envelope;
import org.locationtech.jts.geom.GeometryFactory;
import org.locationtech.jts.geom.Coordinate;
import org.locationtech.jts.geom.LinearRing;
import org.locationtech.jts.geom.Polygon;

import static org.mockito.Mockito.mock;

public class PolygongetMaxLon_EnvelopegetMaxXFikaTest {

    @Test
    public void testGetMaxLonCallsEnvelopeGetMaxX() {
        // Create a real JTS Polygon with a valid geometry
        GeometryFactory geometryFactory = new GeometryFactory();
        Coordinate[] coordinates = new Coordinate[] {
            new Coordinate(0, 0),
            new Coordinate(10, 0),
            new Coordinate(10, 10),
            new Coordinate(0, 10),
            new Coordinate(0, 0)
        };
        LinearRing shell = geometryFactory.createLinearRing(coordinates);
        Polygon jtsPolygon = geometryFactory.createPolygon(shell, null);
        
        // Create the GraphHopper Polygon using the real JTS Polygon
        Polygon ghPolygon = new Polygon(jtsPolygon);
        
        // Execute the entry point method
        ghPolygon.getMaxLon();
    }
}

