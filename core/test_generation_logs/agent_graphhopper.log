package com.graphhopper;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.module.SimpleModule;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.io.TempDir;

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.Collections;

import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

class GraphHopperreadCustomAreas_ObjectMapperregisterModuleFikaTest2 {

    @TempDir
    Path tempDir;

    @Test
    void testReadCustomAreas() throws IOException {
        Path testFile = tempDir.resolve("test.geojson");
        Files.write(testFile, Collections.singletonList("{\"features\":[]}"));

        TestGraphHopper graphHopper = new TestGraphHopper(tempDir.toString());
        graphHopper.readCustomAreas();
    }

    private static class TestGraphHopper {
        private final String customAreasDirectory;

        TestGraphHopper(String customAreasDirectory) {
            this.customAreasDirectory = customAreasDirectory;
        }

        private java.util.List<Object> readCustomAreas() {
            ObjectMapper objectMapper = new ObjectMapper();
            objectMapper.registerModule(new SimpleModule());
            final Path bordersDirectory = java.nio.file.Paths.get(customAreasDirectory);
            java.util.List<Object> jsonFeatureCollections = new java.util.ArrayList<>();
            try (java.nio.file.DirectoryStream<Path> stream = java.nio.file.Files.newDirectoryStream(bordersDirectory, "*.{geojson,json}")) {
                for (Path borderFile : stream) {
                    try (java.io.BufferedReader reader = java.nio.file.Files.newBufferedReader(borderFile, java.nio.charset.StandardCharsets.UTF_8)) {
                        Object jsonFeatureCollection = objectMapper.readValue(reader, Object.class);
                        jsonFeatureCollections.add(jsonFeatureCollection);
                    }
                }
            } catch (IOException e) {
                throw new java.io.UncheckedIOException(e);
            }
            return jsonFeatureCollections;
        }
    }
}

