            Coordinate coord2 = new Coordinate(1, 0);
            Mockito.when(mockOrig.getCoordinate()).thenReturn(coord1);
            Mockito.when(mockDest.getCoordinate()).thenReturn(coord2);
            Mockito.when(mockOrig.midPoint(mockDest)).thenReturn(new Object() {
                public Coordinate getCoordinate() {
                    return new Coordinate(0.5, 0);
                }
