    @Test
    void testHasAccess() {
        // Create real IntArrayList objects
        IntArrayList keysAndBwdFlags = new IntArrayList();
        keysAndBwdFlags.add(1); // Binary: 0001, LSB is 1 -> has access
        keysAndBwdFlags.add(2); // Binary: 0010, LSB is 0 -> no access
        
        IntArrayList adjNodesAndFwdFlags = new IntArrayList();
        adjNodesAndFwdFlags.add(3); // Binary: 0011, LSB is 1 -> has access
        adjNodesAndFwdFlags.add(4); // Binary: 0100, LSB is 0 -> no access
        
        // Create mock Graph with the real IntArrayList objects
        Graph graph = Mockito.mock(Graph.class);
        when(graph.keysAndBwdFlags).thenReturn(keysAndBwdFlags);
        when(graph.adjNodesAndFwdFlags).thenReturn(adjNodesAndFwdFlags);
        
        // Create instance of OrigEdgeIteratorImpl
        OrigEdgeIteratorImpl iterator = new OrigEdgeIteratorImpl();
        
        // Use reflection to set private fields
        try {
            java.lang.reflect.Field graphField = OrigEdgeIteratorImpl.class.getDeclaredField("graph");
            graphField.setAccessible(true);
            graphField.set(iterator, graph);
            
            java.lang.reflect.Field reverseField = OrigEdgeIteratorImpl.class.getDeclaredField("reverse");
            reverseField.setAccessible(true);
            
            java.lang.reflect.Field indexField = OrigEdgeIteratorImpl.class.getDeclaredField("index");
            indexField.setAccessible(true);
            
            // Test with reverse = true
            reverseField.set(iterator, true);
            indexField.set(iterator, 0);
            iterator.hasAccess(); // Should invoke keysAndBwdFlags.get(0)
            
            // Test with reverse = false  
            reverseField.set(iterator, false);
            indexField.set(iterator, 0);
            iterator.hasAccess(); // Should invoke adjNodesAndFwdFlags.get(0)
            
            // Test with different indices to ensure get() is called
            indexField.set(iterator, 1);
            iterator.hasAccess(); // Should invoke adjNodesAndFwdFlags.get(1)
            
            reverseField.set(iterator, true);
            iterator.hasAccess(); // Should invoke keysAndBwdFlags.get(1)
            
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }
}

