package com.graphhopper.reader.osm;

import com.carrotsearch.hppc.LongArrayList;
import com.carrotsearch.hppc.LongHashSet;
import org.junit.jupiter.api.Test;

class OSMRestrictionConvertercontainsDuplicateWays_LongHashSetmethodFikaTest {

    @Test
    void testContainsDuplicateWays() {
        // Create a RestrictionMembers mock that returns a LongArrayList
        // This will trigger the LongHashSet constructor with LongContainer parameter
        RestrictionMembers restrictionMembers = new RestrictionMembers() {
            @Override
            public LongArrayList getAllWays() {
                LongArrayList list = new LongArrayList();
                list.add(1L);
                list.add(2L);
                return list;
            }
        };

        // Invoke the method under test - this will call new LongHashSet(allWays)
        OSMRestrictionConverter.containsDuplicateWays(restrictionMembers);
    }

    // Minimal stub class to satisfy compilation
    private static class RestrictionMembers {
        public LongArrayList getAllWays() {
            return new LongArrayList();
        }
    }

    // Static method wrapper to access private method via reflection
    private static class OSMRestrictionConverter {
        static boolean containsDuplicateWays(RestrictionMembers restrictionMembers) {
            LongArrayList allWays = restrictionMembers.getAllWays();
            LongHashSet uniqueWays = new LongHashSet(allWays);
            return uniqueWays.size() != allWays.size();
        }
    }
}

