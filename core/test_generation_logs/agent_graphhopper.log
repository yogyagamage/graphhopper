        EncodingManager encodingManager = EncodingManager.start().add(accessEnc).add(speedEnc).build();
        Graph graph = new BaseGraph.Builder(encodingManager).create();
        
        // Add three vertices forming a triangle
        graph.edge(0, 1).set(accessEnc, true).set(speedEnc, 60.0);
        graph.edge(1, 2).set(accessEnc, true).set(speedEnc, 60.0);
        graph.edge(2, 0).set(accessEnc, true).set(speedEnc, 60.0);
        
        // Create QuadEdge triangulation with the triangle
        List<ReadableQuadEdge> seedEdges = new ArrayList<>();
        // We need to create a QuadEdge structure that will produce at least one ring
