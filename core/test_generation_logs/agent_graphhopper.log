private Map<String, String> filter(Map<String, Object> tags) {
    Map<String, String> map = new HashMap<>(tags.size());
    for (Map.Entry<String, Object> entry : tags.entrySet()) {
        String key = entry.getKey();
        // PATH: Test should invoke the next LegalDefaultSpeeds.isRelevantTagKey(...) [step in execution path]
        if (((speeds.isRelevantTagKey(key) || key.equals("country")) || key.equals("country_state")) || // the :conditional tags are not yet necessary for us and expensive in the speeds library
