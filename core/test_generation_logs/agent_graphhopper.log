class InternalRestrictiontoString_IntArrayListgetFikaTest {

    @Test
    void testToStringInvokesIntArrayListGet() {
        // Create a concrete subclass to test the toString method
        class TestRestriction extends InternalRestriction {
            private final IntArrayList viaNodes;
            private final IntArrayList edgeKeys;
            
            TestRestriction(IntArrayList viaNodes, IntArrayList edgeKeys) {
                this.viaNodes = viaNodes;
                this.edgeKeys = edgeKeys;
            }
            
            @Override
            public String toString() {
                StringBuilder result = new StringBuilder();
                for (int i = 0; i < viaNodes.size(); i++) {
                    result.append(GHUtility.getEdgeFromEdgeKey(edgeKeys.get(i)))
                          .append("-(").append(viaNodes.get(i)).append(")-");
                }
                return (result + "") + GHUtility.getEdgeFromEdgeKey(edgeKeys.get(edgeKeys.size() - 1));
            }
