import org.junit.jupiter.api.Test;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

public class Polygoncontains_GeometryFactorycreatePointFikaTest {
    
    @Test
    public void testContainsInvokesCreatePoint() {
        GeometryFactory factory = new GeometryFactory();
        Coordinate coordinate = new Coordinate(10.0, 20.0);
        
        Polygon polygon = mock(Polygon.class);
        PreparedPolygon prepPolygon = new PreparedPolygon(polygon);
        
        Polygon target = new Polygon() {
            private final GeometryFactory factory = GeometryFactory::new;
            private PreparedPolygon prepPolygon = prepPolygon;
            
            public boolean contains(double lat, double lon) {
                return prepPolygon.contains(factory.createPoint(new Coordinate(lon, lat)));
            }
        };
        
        target.contains(20.0, 10.0);
    }
    
    private abstract static class Polygon {
        public abstract boolean contains(double lat, double lon);
    }
}

