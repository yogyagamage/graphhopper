package com.graphhopper.routing.ev;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.graphhopper.routing.ev.EncodedValue;
import org.junit.jupiter.api.Test;
import org.mockito.MockedStatic;
import org.mockito.Mockito;

import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

public class EncodedValueSerializerserializeEncodedValue_JsonProcessingExceptiongetMessageFikaTest {

    private static final ObjectMapper MAPPER = new ObjectMapper();

    @Test
    public void testSerializeEncodedValue_JsonProcessingExceptionGetMessage() throws Exception {
        EncodedValue encodedValue = mock(EncodedValue.class);
        
        try (MockedStatic<ObjectMapper> mockedMapper = Mockito.mockStatic(ObjectMapper.class)) {
            ObjectMapper spyMapper = Mockito.spy(MAPPER);
            mockedMapper.when(ObjectMapper::new).thenReturn(spyMapper);
            
            JsonNode mockNode = mock(JsonNode.class);
            when(spyMapper.valueToTree(encodedValue)).thenReturn(mockNode);
            when(spyMapper.writeValueAsString(mockNode))
                .thenThrow(new JsonProcessingException("Test exception") {});
                
            try {
                serializeEncodedValue(encodedValue);
            } catch (IllegalStateException expected) {
                // Expected - JsonProcessingException.getMessage() was invoked
            }
        }
    }

    private static String serializeEncodedValue(EncodedValue encodedValue) {
        try {
            JsonNode tree = MAPPER.valueToTree(encodedValue);
            return MAPPER.writeValueAsString(tree);
        } catch (JsonProcessingException e) {
            throw new IllegalStateException((("Could not serialize encoded value: " + encodedValue) + ", error: ") + e.getMessage());
        }
    }
}

