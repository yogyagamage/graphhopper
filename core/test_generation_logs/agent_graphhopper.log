        // Create geometry factory with a valid SRID
        GeometryFactory geometryFactory = new GeometryFactory(new PrecisionModel(), 4326);
        
        // Create a simple square shell (CCW - negative signed area)
        Coordinate[] shellCoords = new Coordinate[] {
            new Coordinate(0, 0),
            new Coordinate(10, 0),
            new Coordinate(10, 10),
            new Coordinate(0, 10),
            new Coordinate(0, 0)
        };
        LinearRing shellRing = geometryFactory.createLinearRing(shellCoords);
        
        // Create a simple hole inside the shell (CW - positive signed area)
        Coordinate[] holeCoords = new Coordinate[] {
            new Coordinate(2, 2),
            new Coordinate(8, 2),
            new Coordinate(8, 8),
            new Coordinate(2, 8),
            new Coordinate(2, 2)
        };
        LinearRing holeRing = geometryFactory.createLinearRing(holeCoords);
        
        // Create the list of rings (one shell, one hole)
        List<LinearRing> rings = new ArrayList<>();
        rings.add(shellRing);
        rings.add(holeRing);
        
