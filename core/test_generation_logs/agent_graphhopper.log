            // Mock frame vertex checks
            Mockito.when(contourBuilder.isFrameVertex(mockOrig)).thenReturn(false);
            Mockito.when(contourBuilder.isFrameVertex(mockDest)).thenReturn(false);
            
            seedEdges.add(mockEdge);
        }
        
        // Execute the entry point method
        contourBuilder.computeIsoline(cut, seedEdges);
    }
}

