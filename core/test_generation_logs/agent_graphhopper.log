class OrigEdgeIteratorImplgetOrigEdgeKeyFirst_IntArrayListgetFikaTest {
    
    @Test
    void testGetOrigEdgeKeyFirst() {
        // Create a concrete instance that will be used as the graph field
        GraphWithKeys graph = new GraphWithKeys();
        
        // Create the object under test
        TestOrigEdgeIteratorImpl iterator = new TestOrigEdgeIteratorImpl(graph, 0);
        
        // Invoke the method - this should trigger IntArrayList.get(int)
