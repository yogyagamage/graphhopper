private QueryOverlay build(List<Snap> resList) // PATH: Test should invoke the next QueryOverlayBuilder.buildEdgeChangesAtRealNodes(...) [step in execution path]
{
    queryOverlay = new QueryOverlay(resList.size(), is3D);
