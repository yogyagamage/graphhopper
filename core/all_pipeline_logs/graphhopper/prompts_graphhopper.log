    if (e2 == null) {
        e2 = QuadEdge.makeEdge(getVertex(v2), getVertex(v3));
        QuadEdge.splice(e1.lNext(), e2);
        putEdge(v2, v3, e2);
        putEdge(v3, v2, e2.sym());
    }
    if (e3 == null) {
        if (e1.lNext() == e2) {
            e3 = QuadEdge.connect(e2, e1);
        } else if (e2.lNext() == e1) {
            throw new RuntimeException();
        } else {
            QuadEdge.splice(e1.lNext(), e2);
            e3 = QuadEdge.connect(e2, e1);
        }
        putEdge(v3, v1, e3);
        putEdge(v1, v3, e3.sym());
    } else {
        if (e1.lNext() != e2) {
            QuadEdge.splice(e1.lNext(), e2);
        }
        if (e2.lNext() != e3) {
            QuadEdge.splice(e2.lNext(), e3);
        }
        if (e3.lNext() != e1) {
