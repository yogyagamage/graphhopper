    }
    // PATH: Test should invoke the next IntArrayList.equals(...) [step in execution path]
    return ((InternalRestriction) (obj)).viaNodes.equals(viaNodes) && ((InternalRestriction) (obj)).edgeKeys.equals(edgeKeys);
}
