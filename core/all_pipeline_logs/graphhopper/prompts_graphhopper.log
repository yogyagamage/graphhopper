    singleEdgeComponents = new BitSet(Math.max(edgeKeys, 0));
    if (!singleEdgeComponents.getClass().getName().contains("hppc"))
        throw new IllegalStateException("Was meant to be hppc BitSet");

    biggestComponent = new IntArrayList();
}

