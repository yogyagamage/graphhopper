                EdgeIteratorState origEdge = queryGraph.getEdgeIteratorStateForKey(((VirtualEdgeIteratorState) (virtualEdge)).getOriginalEdgeKey());
                return edgeFilter.accept(origEdge, reverse);
            } else {
