        boolean ccw = cut0 > 0;
        while (true) {
            // Add a point to polyline
            Coordinate cC;
            if (isFrameVertex(e.orig())) {
                cC = moveEpsilonTowards(e.dest().getCoordinate(), e.orig().getCoordinate());
            } else if (isFrameVertex(e.dest())) {
