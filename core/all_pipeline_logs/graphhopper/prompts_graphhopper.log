 */
public void importAndClose() {
    if (!load()) // PATH: Test should invoke the next GraphHopper.process(...) [step in execution path]
    {
        printInfo();
        process(true);
    } else {
        printInfo();
        logger.info("Graph already imported into " + ghLocation);
