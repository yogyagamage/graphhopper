    if (((fromEdge < 0) || (toEdge < 0)) || (viaNode < 0))
        throw new IllegalArgumentException("from/toEdge and viaNode must be >= 0");

    baseGraph.getTurnCostStorage().set(turnRestrictionEnc, fromEdge, viaNode, toEdge, true);
}

