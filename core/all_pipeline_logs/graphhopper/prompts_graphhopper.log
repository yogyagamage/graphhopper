    baseEdge.setReverseEdge(baseReverseEdge);
    baseReverseEdge.setReverseEdge(baseEdge);
    queryOverlay.addVirtualEdge(baseEdge);
    queryOverlay.addVirtualEdge(baseReverseEdge);
