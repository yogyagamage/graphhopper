        }
    }
    landmarkWeightDA.setHeader(0 * 4, graph.getNodes());
    landmarkWeightDA.setHeader(1 * 4, this.landmarks);
    landmarkWeightDA.setHeader(2 * 4, subnetworkCount);
    if ((factor * DOUBLE_MLTPL) > Integer.MAX_VALUE)
