            processed.add(e);
            ReadableQuadEdge E1 = (ccw) ? e.oNext().getPrimary() : e.oPrev().getPrimary();
            ReadableQuadEdge E2 = (ccw) ? e.dPrev().getPrimary() : e.dNext().getPrimary();
            int cut1 = (E1 == null) ? 0 : cut.applyAsInt(E1.orig(), E1.dest());
