    }
    if (logDetails)
        LOGGER.info(((("init landmarks for subnetworks with node count greater than " + minimumNodes) + " with factor:") + factor) + additionalInfo);

    int nodes = 0;
    for (IntArrayList subnetworkIds : graphComponents.getComponents()) {
