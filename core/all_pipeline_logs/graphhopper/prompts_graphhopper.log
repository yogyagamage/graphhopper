private byte[] readBlobContent() throws IOException {
    Fileformat.Blob blob = Fileformat.Blob.parseFrom(rawBlob);
    byte[] blobData;
    // PATH: Test should invoke the next Fileformat$Blob.hasRaw(...) [step in execution path]
    if (blob.hasRaw()) {
