        Vertex v2 = new Vertex(1, 0);
        Vertex v3 = new Vertex(0, 1);
        
        // Create QuadEdges for the triangle
        QuadEdge e1 = QuadEdge.makeEdge(v1, v2);
        QuadEdge e2 = QuadEdge.makeEdge(v2, v3);
        QuadEdge e3 = QuadEdge.makeEdge(v3, v1);
        
        // Connect them to form a triangle
        QuadEdge.splice(e1.sym(), e2);
        QuadEdge.splice(e2.sym(), e3);
