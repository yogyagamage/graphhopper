import org.locationtech.jts.geom.Envelope;
import org.locationtech.jts.geom.GeometryFactory;
import org.locationtech.jts.geom.Polygon;
import org.locationtech.jts.geom.PreparedPolygon;
import org.locationtech.jts.geom.impl.PackedCoordinateSequence;

import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

public class PolygongetMaxLon_EnvelopegetMaxXFikaTest {

    @Test
    public void testGetMaxLonCallsEnvelopeGetMaxX() {
        // Create a real Envelope that will be returned by the PreparedPolygon
        Envelope realEnvelope = new Envelope(0.0, 1.0, 0.0, 1.0);
        
        // Create a mock PreparedPolygon that returns a real Polygon with the real Envelope
        PreparedPolygon mockPreparedPolygon = mock(PreparedPolygon.class);
        GeometryFactory geometryFactory = new GeometryFactory();
        
        // Create a real Polygon with coordinates that will produce an envelope
        Coordinate[] coordinates = new Coordinate[] {
            new Coordinate(0.0, 0.0),
            new Coordinate(1.0, 0.0),
            new Coordinate(1.0, 1.0),
            new Coordinate(0.0, 1.0),
            new Coordinate(0.0, 0.0)
        };
        Polygon realPolygon = geometryFactory.createPolygon(coordinates);
        
        // Configure the mock to return the real Polygon and its envelope
        when(mockPreparedPolygon.getGeometry()).thenReturn(realPolygon);
        
        // Create the Polygon instance using the constructor that takes PreparedPolygon
        Polygon polygon = new Polygon(mockPreparedPolygon);
        
        // Call the entry point method - this should trigger envelope.getMaxX()
        polygon.getMaxLon();
    }
}

