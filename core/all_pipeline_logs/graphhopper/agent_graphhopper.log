        com.graphhopper.storage.NodeAccess nodeAccess = Mockito.mock(com.graphhopper.storage.NodeAccess.class);
        when(queryGraph.getNodeAccess()).thenReturn(nodeAccess);
        when(nodeAccess.getLat(anyInt())).thenReturn(0.0);
        when(nodeAccess.getLon(anyInt())).thenReturn(0.0);

        when(snap.getClosestNode()).thenReturn(0);

        ShortestPathTree.IsoLabel isoLabel = Mockito.mock(ShortestPathTree.IsoLabel.class);
