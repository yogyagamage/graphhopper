import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.util.ArrayList;
import java.util.List;

class ViaRoutingbuildEdgeRestrictions_IntArrayListaddAllFikaTest {

    @Test
    void testCalcPathsToBuildEdgeRestrictionsToIntArrayListAddAll() {
        // Create mocks for required parameters
        QueryGraph queryGraph = Mockito.mock(QueryGraph.class);
        DirectedEdgeFilter directedEdgeFilter = Mockito.mock(DirectedEdgeFilter.class);
        PathCalculator pathCalculator = Mockito.mock(PathCalculator.class);
        
        // Create minimal required data
        List<GHPoint> points = new ArrayList<>();
        points.add(new GHPoint(0, 0));
        points.add(new GHPoint(1, 1));
        
        List<Snap> snaps = new ArrayList<>();
        Snap snap1 = Mockito.mock(Snap.class);
        Snap snap2 = Mockito.mock(Snap.class);
        snaps.add(snap1);
        snaps.add(snap2);
        
        // Configure snaps to return different closest nodes to avoid special case
        Mockito.when(snap1.getClosestNode()).thenReturn(1);
        Mockito.when(snap2.getClosestNode()).thenReturn(2);
        
        // Configure queryGraph to avoid virtual edge handling
        Mockito.when(queryGraph.isVirtualEdge(Mockito.anyInt())).thenReturn(false);
        
        // Configure pathCalculator to return an empty path list
        Mockito.when(pathCalculator.calcPaths(Mockito.anyInt(), Mockito.anyInt(), Mockito.any()))
               .thenReturn(new ArrayList<>());
        
        // Create empty lists for optional parameters
        List<String> curbsides = new ArrayList<>();
        List<Double> headings = new ArrayList<>();
        
        // Add a heading to trigger the heading resolver path
        headings.add(90.0);
        headings.add(Double.NaN); // Second heading NaN to avoid second addAll
        
        // Call the entry point method
        ViaRouting.calcPaths(
            points,
            queryGraph,
            snaps,
            directedEdgeFilter,
            pathCalculator,
            curbsides,
            "strict",
            headings,
            false
        );
    }
}

