package com.graphhopper.isochrone.algorithm;

import com.graphhopper.routing.RouterConfig;
import com.graphhopper.routing.querygraph.QueryGraph;
import com.graphhopper.storage.index.Snap;
import com.graphhopper.isochrone.algorithm.ShortestPathTree;
import org.junit.jupiter.api.Test;
import org.locationtech.jts.geom.Coordinate;
import org.locationtech.jts.triangulate.DelaunayTriangulationBuilder;
import org.locationtech.jts.triangulate.quadedge.QuadEdgeSubdivision;
import org.locationtech.jts.triangulate.quadedge.Vertex;

import java.util.ArrayList;
import java.util.Collection;
import java.util.function.ToDoubleFunction;

import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

public class JTSTriangulatortriangulate_VertexsetZFikaTest {

    @Test
    public void testTriangulate() throws Exception {
        RouterConfig routerConfig = mock(RouterConfig.class);
        when(routerConfig.getMaxVisitedNodes()).thenReturn(3000);

        JTSTriangulator jtsTriangulator = new JTSTriangulator(routerConfig);

        Snap snap = mock(Snap.class);
        QueryGraph queryGraph = mock(QueryGraph.class);
        ShortestPathTree shortestPathTree = mock(ShortestPathTree.class);
        ToDoubleFunction<ShortestPathTree.IsoLabel> fz = mock(ToDoubleFunction.class);

        Collection<Coordinate> sites = new ArrayList<>();
        sites.add(new Coordinate(1.0, 2.0, 3.0));
        sites.add(new Coordinate(4.0, 5.0, 6.0));
        sites.add(new Coordinate(7.0, 8.0, 9.0));

        DelaunayTriangulationBuilder triangulationBuilder = new DelaunayTriangulationBuilder();
        triangulationBuilder.setSites(sites);
        triangulationBuilder.setTolerance(0.0);

        QuadEdgeSubdivision tin = triangulationBuilder.getSubdivision();
        for (Vertex vertex : ((Collection<Vertex>) (tin.getVertices(true)))) {
            if (tin.isFrameVertex(vertex)) {
                vertex.setZ(Double.MAX_VALUE);
            }
        }

        jtsTriangulator.triangulate(snap, queryGraph, shortestPathTree, fz, 0.0);
    }
}

